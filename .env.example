# studyagent — variáveis de ambiente
# O programa NÃO lê este arquivo sozinho. Use de um destes jeitos:
#   - no terminal:  cp .env.example .env && set -a && . ./.env && set +a
#   - no systemd:   EnvironmentFile=/etc/studyagent/agent.env  (só as variáveis do agente; veja deploy/)
# Tudo é opcional, exceto o que está marcado como OBRIGATÓRIO.

# ---------- agente com LLM (studyagent agent evaluate|review) ----------
# OBRIGATÓRIO para o avaliador. Crie em https://console.groq.com/keys
GROQ_API_KEY=gsk_troque_por_sua_chave
# Modelo do Groq (padrão: llama-3.3-70b-versatile). Troque se o Groq aposentar este.
#STUDYAGENT_GROQ_MODEL=llama-3.3-70b-versatile

# ---------- cliente (CLI e agente falando com o daemon) ----------
# Token da API. Gere com:  studyagent admin token-create shell user --out ~/.config/studyagent/token
# Se não definir nenhum dos dois, a CLI lê ~/.config/studyagent/token
#STUDYAGENT_TOKEN=sa_...
#STUDYAGENT_TOKEN_FILE=/etc/studyagent/planner.token     # agente: use um token de escopo "planner"
# Socket do daemon (padrão: /run/studyagent/api.sock se existir; senão $XDG_RUNTIME_DIR/studyagent.sock)
#STUDYAGENT_SOCKET=/run/studyagent/api.sock

# ---------- daemon (studyagent serve) ----------
# Pasta do banco SQLite (padrão: ~/.local/share/studyagent; no systemd vem de StateDirectory)
#STUDYAGENT_STATE_DIR=/var/lib/studyagent
# Kanban do Obsidian que o daemon gera (somente leitura para você). Vazio = não gera.
STUDYAGENT_TASKS_FILE=/home/kaiqbbrs/Obsidian Vault/Agente/Tarefas.md
# Nomes das colunas do Kanban
#STUDYAGENT_LANE_OPEN=A fazer
#STUDYAGENT_LANE_DONE=Concluído
# 0 desliga o planejador automático (propostas de plano e de folgas)
#STUDYAGENT_PLANNER=1

# ---------- definidas pelo systemd (não precisa mexer) ----------
# STATE_DIRECTORY, RUNTIME_DIRECTORY
